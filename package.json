{
  "name": "nodeapp",
  "version": "1.0.0",
  "description": "A sample Node.js app using MySQL and Redis",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "test": "mocha app-test.js --timeout 10000 --reporter mocha-junit-reporter --exit",
    "coverage": "nyc --reporter cobertura --reporter lcov --reporter text --reporter json-summary  mocha app-test.js --timeout 10000  --exit"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.17.1",
    "mysql": "^2.18.1",
    "redis": "^3.1.0"
  },
  "devDependencies": {
  "chai": "^4.3.8",
  "chai-http": "^4.4.0",
  "mocha": "^10.4.0",
  "nyc": "^15.1.0"
  },
  "nyc": {
    "include": [
      "app.js"
    ],
    "exclude": [
      "test"
    ],
    "reporter": [
      "lcov",
      "text"
    ],
    "all": true
  }
}
