{
  "name": "nodeapp",
  "version": "1.0.0",
  "description": "A sample Node.js app using MySQL and Redis",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "test": "mocha --reporter spec --exit",
    "coverage": "nyc --reporter=lcov --reporter=text mocha"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.17.1",
    "mysql": "^2.18.1",
    "redis": "^3.1.0"
  },
  "devDependencies": {
    "chai": "*",
    "chai-http": "*",
    "mocha": "*",
    "nyc": "*"
  },
  "nyc": {
    "include": [
      "app.js"
    ],
    "exclude": [
      "test"
    ],
    "reporter": [
      "lcov",
      "text"
    ],
    "all": true
  }
}
